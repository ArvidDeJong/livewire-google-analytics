{
    "name": "darvis/livewire-google-analytics",
    "description": "Google Analytics 4 event tracking for Laravel Livewire: a trait that dispatches a browser event and a small listener that forwards it to gtag().",
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/livewire-google-analytics/",
    "keywords": [
        "laravel",
        "livewire",
        "google-analytics",
        "ga4",
        "gtag",
        "analytics",
        "tracking",
        "events",
        "laravel-boost"
    ],
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/livewire-google-analytics/issues",
        "source": "https://github.com/ArvidDeJong/livewire-google-analytics",
        "docs": "https://arviddejong.github.io/livewire-google-analytics/"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Darvis\\LivewireGoogleAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\LivewireGoogleAnalytics\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest tests",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\LivewireGoogleAnalytics\\GoogleAnalyticsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
